# Copy this file to .env and edit it locally. .env is ignored by git.
TZ=America/Los_Angeles
LIBRARY_PORT=8083

# Configure either TMDB option, not both. A read access token is preferred.
# https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
TMDB_LANGUAGE=en-US

# Set true only if the data directories live on an NFS/SMB network share.
NETWORK_SHARE_MODE=false
