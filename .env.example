# Copy this file to .env and edit it locally. .env is ignored by git.
TZ=America/Los_Angeles
LIBRARY_PORT=8083

# Configure either TMDB option, not both. A read access token is preferred.
# https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_LANGUAGE=en-US

# Set true only if the data directories live on an NFS/SMB network share.
NETWORK_SHARE_MODE=false

# Seconds to wait for online metadata providers before showing partial results.
CWA_METADATA_SEARCH_TIMEOUT=10

# Optional companion-library links shown in the profile menu.
AUDIOBOOKSHELF_URL=
PLEX_URL=
JELLYFIN_URL=
GRIMMORY_URL=

# Optional scheduled Hardcover "Want to Read" sync into the wishlist.
HARDCOVER_SYNC_ENABLED=false
HARDCOVER_SYNC_SHELF=want-to-read
HARDCOVER_SYNC_CONTENT_TYPE=book
HARDCOVER_SYNC_INTERVAL_HOURS=24
